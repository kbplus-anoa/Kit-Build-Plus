# 复制成 .env 后按需填写。不填也能跑：种子库自带一份教材与它的目标图。
# .env 已在 .gitignore 里，不要提交。

# 数据库位置，默认仓库根 tmp/kb.sqlite3
KBP_DB_PATH=

# 换个 env 文件位置，默认仓库根 .env
KBP_ENV_FILE=

# 从教材抽目标图的模型接口，走 OpenAI 兼容协议；不填就只用种子库里已有的目标图
KBP_EXTRACT_ENABLED=
KBP_EXTRACT_BASE_URL=
KBP_EXTRACT_MODEL=
KBP_API_KEY=
KBP_EXTRACT_TIMEOUT_S=
KBP_EXTRACT_MAX_CHARS=
KBP_EXTRACT_REASONING_EFFORT=

# 扫描件才走 MinerU OCR，有文本层的 PDF 不需要
MINERU_TOKEN=
MINERU_BASE_URL=
MINERU_MODEL=
MINERU_LANG=
MINERU_POLL_S=
MINERU_TIMEOUT_S=
MINERU_MAX_POLLS=

# 上传目录与解析缓存，默认落在仓库根 tmp/ 下
KBP_UPLOAD_DIR=
KBP_INGEST_CACHE=
